# =============================================================================
# Staging 环境 K8s Secret 配置示例
# 使用方式: cp .env.staging.example .env.staging 并填写真实值
# 注意: .env.staging（无 .example 后缀）已加入 .gitignore，禁止提交到 Git
# =============================================================================

# ---- RDS MySQL 连接信息 ----
# 从 terraform output 获取: terraform output rds_connection_host
RDS_HOST=rm-xxxxxxxxxxxxxxxx.mysql.rds.aliyuncs.com
RDS_PORT=3306
RDS_USER=eksjk_staging_user
RDS_PASSWORD=your_staging_db_password_here
RDS_DATABASE=eksjk_staging

# ---- 阿里云 OSS 配置 ----
# Endpoint 格式: https://oss-cn-shanghai.aliyuncs.com（内网用 internal 域名）
OSS_ENDPOINT=https://oss-cn-shanghai-internal.aliyuncs.com
OSS_BUCKET=eksjk-staging
OSS_REGION=cn-shanghai
# 使用 RAM 子账号的 AccessKey（非主账号）
OSS_ACCESS_KEY=your_oss_access_key_id_here
OSS_SECRET_KEY=your_oss_access_key_secret_here

# ---- JWT 签名密钥 ----
# 建议使用 openssl rand -base64 64 生成，长度不少于 32 字符
JWT_SECRET=your_jwt_signing_secret_here_at_least_32_chars
